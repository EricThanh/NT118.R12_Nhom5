<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SellerOrderTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="SellerTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">31dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SellerFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seller_ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SellerInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/seller_bg_input</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">@color/seller_ink</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SellerDayLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seller_chart_label</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SellerStatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/seller_bg_stat</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SellerStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_body</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SellerStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seller_ink2</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="SellerBestRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SellerBestRank">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_body</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SellerBestThumb">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/seller_bg_thumb_f2</item>
    </style>

    <style name="SellerBestName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seller_ink2</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SellerBestSold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_body</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SellerBestPrice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seller_ink2</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="SellerHomeStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:background">@drawable/seller_bg_home_stat</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/seller_ink</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SellerHomeCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:background">@drawable/seller_bg_home_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="SellerHomeThumb">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:background">@drawable/seller_bg_home_thumb</item>
    </style>

    <style name="SellerHomeName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seller_ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SellerHomePrice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seller_ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SellerHomeQtyRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SellerHomeQtyButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minWidth">12dp</item>
        <item name="android:textColor">@color/seller_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SellerHomeQtyBox">
        <item name="android:layout_width">23dp</item>
        <item name="android:layout_height">23.5dp</item>
        <item name="android:layout_marginHorizontal">9dp</item>
        <item name="android:background">@drawable/seller_bg_qty</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seller_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SellerSizeChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
