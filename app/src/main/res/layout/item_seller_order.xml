<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/seller_bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_order_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:text="#1024"
            android:textColor="@color/seller_ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tv_order_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/montserrat_medium"
            android:includeFontPadding="false"
            android:text="12/10/2023, 14:30"
            android:textColor="@color/text_body"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/seller_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/seller_bg_home_avatar"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/ic_user"
            app:tint="@color/seller_sub" />

        <TextView
            android:id="@+id/tv_buyer_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Luka Marjanovic"
            android:textColor="@color/seller_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_total_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:text="$282.00"
            android:textColor="@color/seller_ink"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_view_order_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/montserrat_bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp"
        android:text="Xem chi tiết ›"
        android:textColor="@color/seller_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/layout_order_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_reject_order"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/seller_bg_btn_outlined"
            android:elevation="0dp"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="Từ chối"
            android:textAllCaps="false"
            android:textColor="@color/seller_ink"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm_order"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/seller_bg_ink_r8"
            android:elevation="0dp"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="Xác nhận"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>