<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="16dp">


    <ImageView
        android:id="@+id/ivProductOption"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tvOptionPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivProductOption"
        app:layout_constraintTop_toTopOf="@id/ivProductOption"
        tools:text="1,500,000đ" />

    <TextView
        android:id="@+id/tvOptionStock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivProductOption"
        app:layout_constraintTop_toBottomOf="@id/tvOptionPrice"
        tools:text="Kho: 120" />


    <View
        android:id="@+id/vDivider1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/border"
        app:layout_constraintTop_toBottomOf="@id/ivProductOption" />


    <TextView
        android:id="@+id/tvSizeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Kích cỡ"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vDivider1" />


    <GridLayout
        android:id="@+id/glSizeSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="4"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/tvSizeTitle">

        <TextView
            android:id="@+id/tvSize36"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="36"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSize37"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="37"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSize38"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="38"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSize39"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="39"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSize40"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="40"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSize41"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="41"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSize42"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="42"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSize43"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="43"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSize44"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="44"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"/>

    </GridLayout>


    <TextView
        android:id="@+id/tvQuantityTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Số lượng"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glSizeSelection"
        app:layout_constraintBottom_toBottomOf="@id/llQuantitySelector"/>


    <LinearLayout
        android:id="@+id/llQuantitySelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glSizeSelection">

        <ImageView
            android:id="@+id/btnDecreaseQty"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_minus"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btnIncreaseQty"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_plus"
            app:tint="@color/text_primary" />

    </LinearLayout>


    <View
        android:id="@+id/vDivider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="@color/border"
        app:layout_constraintTop_toBottomOf="@id/llQuantitySelector" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/primary"
        android:text="Xác nhận"
        android:textColor="@android:color/white"
        android:stateListAnimator="@null"
        android:elevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/vDivider2"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>