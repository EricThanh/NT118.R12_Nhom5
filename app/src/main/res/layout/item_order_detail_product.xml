<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_product_thumb"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/seller_bg_thumb"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/placeholder_shoe" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Nike React Miler"
            android:textColor="@color/seller_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_product_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/montserrat_regular"
            android:includeFontPadding="false"
            android:text="Size: 42"
            android:textColor="@color/seller_gray_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat_semibold"
            android:includeFontPadding="false"
            android:text="$140.00"
            android:textColor="@color/seller_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_product_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/seller_bg_badge"
        android:fontFamily="@font/montserrat_bold"
        android:includeFontPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="x2"
        android:textColor="@color/seller_badge_text"
        android:textSize="12sp" />
</LinearLayout>
