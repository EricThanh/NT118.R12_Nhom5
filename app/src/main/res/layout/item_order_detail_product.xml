<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_product_thumb"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/seller_bg_thumb"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/placeholder_shoe" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Nike React Miler"
            android:textColor="#263445"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_product_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_semibold"
            android:includeFontPadding="false"
            android:text="Kích cỡ: EU 42"
            android:textColor="#596579"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="4.250.000đ"
            android:textColor="#263445"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_product_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@null"
        android:fontFamily="@font/montserrat_regular"
        android:includeFontPadding="false"
        android:text="x1"
        android:textColor="#596579"
        android:textSize="16sp" />

</LinearLayout>
