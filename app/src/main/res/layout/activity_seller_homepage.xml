<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/seller_bg_home_avatar" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_semibold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="6dp"
                    android:text=""
                    android:textColor="@color/seller_ink"
                    android:textSize="19sp" />

                <ImageView
                    android:id="@+id/btn_notification"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/seller_bg_bell"
                    android:contentDescription="Thông báo"
                    android:scaleType="center"
                    android:src="@drawable/ic_seller_bell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/seller_bg_banner"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:includeFontPadding="false"
                    android:text="Doanh thu hôm nay"
                    android:textColor="@color/seller_sub"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:includeFontPadding="false"
                    android:text="$840.00"
                    android:textColor="@color/seller_ink"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/seller_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_home_stat_1"
                    style="@style/SellerHomeStat"
                    android:text="5\nĐơn mới" />

                <TextView
                    android:id="@+id/tv_home_stat_2"
                    style="@style/SellerHomeStat"
                    android:layout_marginStart="12dp"
                    android:text="2\nCần giao" />

                <TextView
                    android:id="@+id/tv_home_stat_3"
                    style="@style/SellerHomeStat"
                    android:layout_marginStart="12dp"
                    android:text="1\nHết hàng" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_home_add_product"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/seller_bg_home_add"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Thêm sản phẩm"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_home_view_orders"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/seller_bg_home_view"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Xem đơn hàng"
                    android:textColor="@color/seller_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/montserrat_bold"
                android:includeFontPadding="false"
                android:text="Sản phẩm bán chạy"
                android:textColor="@color/seller_ink"
                android:textSize="18sp" />

            <LinearLayout style="@style/SellerHomeCard">

                <View style="@style/SellerHomeThumb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SellerHomeName"
                        android:text="Nike React Miler" />

                    <TextView
                        style="@style/SellerHomePrice"
                        android:text="$170.00" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:includeFontPadding="false"
                        android:text="Đã bán 11 · Còn 24 đôi"
                        android:textColor="@color/seller_sub"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/SellerHomeCard"
                android:layout_marginTop="12dp">

                <View style="@style/SellerHomeThumb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SellerHomeName"
                        android:text="Nike Air Max 270" />

                    <TextView
                        style="@style/SellerHomePrice"
                        android:text="$112.00" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:includeFontPadding="false"
                        android:text="Đã bán 6 · Còn 1 đôi"
                        android:textColor="@color/seller_sub"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>