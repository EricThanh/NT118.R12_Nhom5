<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:text="Tổng quan"
            android:textColor="@color/seller_ink2"
            android:textSize="26sp" />

        <LinearLayout
            android:id="@+id/btn_period"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/seller_bg_period"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semibold"
                android:includeFontPadding="false"
                android:text="Tuần này"
                android:textColor="@color/seller_ink2"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_seller_down" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/seller_bg_revenue"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_medium"
                        android:includeFontPadding="false"
                        android:text="Doanh thu"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="28.400.000đ"
                        android:textColor="@color/white"
                        android:textSize="28sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="18dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/seller_bg_bar" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/seller_bg_bar" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/seller_bg_bar" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/seller_bg_bar" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/seller_bg_bar" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/seller_bg_bar_active" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/seller_bg_bar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SellerDayLabel"
                        android:text="T2" />

                    <TextView
                        style="@style/SellerDayLabel"
                        android:layout_marginStart="10dp"
                        android:text="T3" />

                    <TextView
                        style="@style/SellerDayLabel"
                        android:layout_marginStart="10dp"
                        android:text="T4" />

                    <TextView
                        style="@style/SellerDayLabel"
                        android:layout_marginStart="10dp"
                        android:text="T5" />

                    <TextView
                        style="@style/SellerDayLabel"
                        android:layout_marginStart="10dp"
                        android:text="T6" />

                    <TextView
                        style="@style/SellerDayLabel"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="T7"
                        android:textColor="@color/white" />

                    <TextView
                        style="@style/SellerDayLabel"
                        android:layout_marginStart="10dp"
                        android:text="CN" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/SellerStatCard"
                    android:layout_marginEnd="6dp">

                    <TextView
                        style="@style/SellerStatLabel"
                        android:text="Đơn mới" />

                    <TextView
                        style="@style/SellerStatValue"
                        android:text="3" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SellerStatCard"
                    android:layout_marginStart="6dp">

                    <TextView
                        style="@style/SellerStatLabel"
                        android:text="Cần giao" />

                    <TextView
                        style="@style/SellerStatValue"
                        android:text="2" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/SellerStatCard"
                    android:layout_marginEnd="6dp">

                    <TextView
                        style="@style/SellerStatLabel"
                        android:text="Đơn trong tuần" />

                    <TextView
                        style="@style/SellerStatValue"
                        android:text="24" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SellerStatCard"
                    android:layout_marginStart="6dp">

                    <TextView
                        style="@style/SellerStatLabel"
                        android:text="Hết hàng" />

                    <TextView
                        style="@style/SellerStatValue"
                        android:text="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:includeFontPadding="false"
                    android:text="Bán chạy nhất"
                    android:textColor="@color/seller_ink2"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:includeFontPadding="false"
                    android:padding="4dp"
                    android:text="Xem tất cả"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/SellerBestRow"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/SellerBestRank"
                    android:text="1" />

                <View style="@style/SellerBestThumb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SellerBestName"
                        android:text="Nike React Miler" />

                    <TextView
                        style="@style/SellerBestSold"
                        android:text="Đã bán 11" />
                </LinearLayout>

                <TextView
                    style="@style/SellerBestPrice"
                    android:text="1.870.000đ" />
            </LinearLayout>

            <LinearLayout
                style="@style/SellerBestRow"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/SellerBestRank"
                    android:text="2" />

                <View style="@style/SellerBestThumb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SellerBestName"
                        android:text="Nike Air Max 270" />

                    <TextView
                        style="@style/SellerBestSold"
                        android:text="Đã bán 6" />
                </LinearLayout>

                <TextView
                    style="@style/SellerBestPrice"
                    android:text="672.000đ" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>