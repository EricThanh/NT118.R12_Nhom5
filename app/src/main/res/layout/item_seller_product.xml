<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/seller_bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/seller_bg_thumb"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_seller_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:includeFontPadding="false"
            android:textColor="@color/seller_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_seller_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/montserrat_semibold"
            android:includeFontPadding="false"
            android:textColor="@color/seller_ink"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_seller_product_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/seller_bg_badge"
                android:fontFamily="@font/montserrat_semibold"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/seller_badge_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_seller_product_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/montserrat_bold"
                android:includeFontPadding="false"
                android:textColor="@color/seller_gray_text"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_seller_edit"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Edit"
            android:src="@drawable/ic_seller_edit" />

        <ImageView
            android:id="@+id/iv_seller_delete"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Delete"
            android:src="@drawable/ic_seller_trash" />
    </LinearLayout>
</LinearLayout>
